let
    // Power BI query name: Confirmation Number <-> LNG_TXT.
    // Remove closed (), [], {} sections first, then paired non-numeric quotes.
    // Unmatched delimiters remain. Quotes touching a digit on either side remain.
    OpenBrackets = {"(", "[", "{"},
    CloseBrackets = {")", "]", "}"},
    Quote = Character.FromNumber(34),
    Digits = {"0".."9"},

    RemoveRanges = (value as text, ranges as list) as text =>
        let
            Sorted = List.Sort(ranges, (a, b) => Value.Compare(a[Start], b[Start])),
            Kept = List.Accumulate(
                Sorted,
                [End = 0, Parts = {}],
                (state, span) =>
                    if span[End] <= state[End] then
                        state
                    else
                        [
                            End = span[End],
                            Parts = state[Parts] & {
                                Text.Range(value, state[End], List.Max({0, span[Start] - state[End]}))
                            }
                        ]
            )
        in
            Text.Combine(Kept[Parts]) & Text.Range(value, Kept[End]),

    CleanLongText = (value as nullable text) as nullable text =>
        if value = null then null else
        let
            BracketPositions = Text.PositionOfAny(value, OpenBrackets & CloseBrackets, Occurrence.All),
            Brackets = List.Accumulate(
                BracketPositions,
                [Stack = {}, Ranges = {}],
                (state, position) =>
                    let
                        Char = Text.At(value, position),
                        Opening = List.PositionOf(OpenBrackets, Char),
                        Top = List.Last(state[Stack], null)
                    in
                        if Opening >= 0 then
                            [
                                Stack = state[Stack] & {[Start = position, Close = CloseBrackets{Opening}]},
                                Ranges = state[Ranges]
                            ]
                        else if Top = null then state
                        else if Char <> Top[Close] then state
                        else
                            [
                                Stack = List.RemoveLastN(state[Stack], 1),
                                Ranges = state[Ranges] & {[Start = Top[Start], End = position + 1]}
                            ]
            ),
            WithoutBrackets = RemoveRanges(value, Brackets[Ranges]),
            Padded = " " & WithoutBrackets & " ",
            QuotePositions = List.Select(
                Text.PositionOf(WithoutBrackets, Quote, Occurrence.All),
                (position) =>
                    not List.Contains(Digits, Text.At(Padded, position))
                    and not List.Contains(Digits, Text.At(Padded, position + 2))
            ),
            QuotePairs = List.Select(List.Split(QuotePositions, 2), each List.Count(_) = 2),
            QuoteRanges = List.Transform(QuotePairs, each [Start = _{0}, End = _{1} + 1])
        in
            RemoveRanges(WithoutBrackets, QuoteRanges),

    Source =
        Sql.Database(
            "SCGReporting",
            "AP101_MPM",
            [
                Query = "
SELECT
    OPR.[OID],
    SUBSTRING(
        OPR.[CNFRM_NBR],
        PATINDEX('%[^0 ]%', OPR.[CNFRM_NBR] + ' '),
        LEN(OPR.[CNFRM_NBR])
    ) AS [CNFRM_NBR],
    LNG.[LNG_TXT]
FROM [dbo].[PROD_ORDR_OPR] OPR
INNER JOIN [dbo].[PROD_ORDR_OPR_LNG] LNG
    ON OPR.[OID] = LNG.[OID]
WHERE OPR.[OPR_PLNT_OID] = 3
"
            ]
        ),

    #"Added Processed Long Text" =
        Table.AddColumn(Source, "P_LNG_TXT", each CleanLongText([LNG_TXT]), type nullable text)
in
    #"Added Processed Long Text"
