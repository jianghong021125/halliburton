let
    Source =
        Sql.Database(
            "scgreporting",
            "powerbi",
            [
                Query =
"
SELECT
      A1.[Material]
    , A1.[Material_NOZERO]
    , B1.Plant
    , B1.MRP_Controller
    , B1.Plant_Matl_Status
    , [Old_Material]
    , [Description]
    , [Material_Group]
    , [Material_Type]
    , [Lab_Office]
    , [Product_Hierarch]
    , [Drawing_Number]
    , [Doc_Version]
    , [Size_Dimension]
    , [Last_Change_Date]
    , [RevLev]
    , [Net_Weight]
    , [Weight_UOM]
    , [Basic_Material]

FROM [PowerBI].[CAR01_CPS_DATA].[V_MATERIAL_MASTER_CPS_HEADER] A1

INNER JOIN [PowerBI].[CAR01_CPS_DATA].[V_MATERIAL_MASTER_CPS_PLANT] B1
    ON A1.Material = B1.Material

INNER JOIN
(
    SELECT
          A1.[MTRL_NBR] AS MTRL_NO
        , B1.PLNT_CD
        , B1.MRP_CNTRLR_CD
        , [SZ_DIM_INFO]

        , CASE
            WHEN LEN([SZ_DIM_INFO]) - LEN(REPLACE([SZ_DIM_INFO], 'X', '')) <> 2
                THEN NULL
            ELSE TRIM('X ' FROM SUBSTRING([SZ_DIM_INFO], 1, CHARINDEX('X', [SZ_DIM_INFO])))
          END AS OD

        , CASE
            WHEN LEN([SZ_DIM_INFO]) - LEN(REPLACE([SZ_DIM_INFO], 'X', '')) <> 2
                THEN NULL
            ELSE SUBSTRING(
                    SUBSTRING([SZ_DIM_INFO], CHARINDEX('X', [SZ_DIM_INFO]) + 1, 40),
                    1,
                    CHARINDEX(
                        'X',
                        SUBSTRING([SZ_DIM_INFO], CHARINDEX('X', [SZ_DIM_INFO]) + 1, 40)
                    ) - 1
                )
          END AS ID

        , CASE
            WHEN LEN([SZ_DIM_INFO]) - LEN(REPLACE([SZ_DIM_INFO], 'X', '')) <> 2
                THEN NULL
            ELSE SUBSTRING(
                    SUBSTRING([SZ_DIM_INFO], CHARINDEX('X', [SZ_DIM_INFO]) + 1, 40),
                    CHARINDEX(
                        'X',
                        SUBSTRING([SZ_DIM_INFO], CHARINDEX('X', [SZ_DIM_INFO]) + 1, 40)
                    ) + 1,
                    40
                )
          END AS [LEN]

    FROM [PowerBI].[DUN02_HESDATAMART01].[V_MTRL] A1

    INNER JOIN [PowerBI].[DUN02_HESDATAMART01].[V_PLNT_MTRL] B1
        ON A1.OID = B1.MTRL_OID

    WHERE PLNT_CD = '2088'
) C1
    ON A1.Material = C1.MTRL_NO

WHERE Plant = '2088'

"
            ]
        )
in
    Source
