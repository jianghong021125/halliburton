WITH BOM_CTE AS
(
    SELECT
        ordr.PROD_ORDR_NBR,
        ordr_bom_dtl.DOC_NBR,
        ordr_bom_dtl.CMPNT_MTRL_OID,
        ordr_bom_dtl.VLD_FRM_DT,
        ROW_NUMBER() OVER (
            PARTITION BY
                ordr.PROD_ORDR_NBR,
                ordr_bom_dtl.DOC_NBR
            ORDER BY
                ordr_bom_dtl.VLD_FRM_DT DESC
        ) AS RN
    FROM AP101_MPM.dbo.PROD_ORDR AS ordr
    LEFT JOIN AP101_MPM.dbo.PROD_ORDR_BOM AS ordr_bom
        ON ordr.OID = ordr_bom.PROD_ORDR_OID
    LEFT JOIN AP101_MPM.dbo.PROD_ORDR_BOM_DTL AS ordr_bom_dtl
        ON ordr_bom.OID = ordr_bom_dtl.PROD_ORDR_BOM_OID
    WHERE ordr_bom_dtl.CMPNT_MTRL_OID IS NULL
    AND NULLIF(LTRIM(RTRIM(ordr_bom_dtl.DOC_NBR)), '') IS NOT NULL
),
LatestBOM AS
(
    SELECT *
    FROM BOM_CTE
    WHERE RN = 1
)
SELECT
      T2.PROD_ORDR_NBR
    , T2.CNFRM_NBR
    , T2.WRK_CNTR_CD
    , T2.LNG_TXT
    , T1.DOC_NBR
    , T1.VLD_FRM_DT
FROM LatestBOM T1
INNER JOIN
(
    SELECT
          L.LNG_TXT
        , O.CNFRM_NBR
        , W.WRK_CNTR_CD
        , P.PROD_ORDR_NBR
    FROM AP101_MPM.dbo.PROD_ORDR_OPR O
    INNER JOIN AP101_MPM.dbo.PROD_ORDR P
        ON P.OID = O.PROD_ORDR_OID
    INNER JOIN AP101_MPM.dbo.PROD_ORDR_OPR_LNG L
        ON L.PROD_ORDR_OPR_OID = O.OID
    INNER JOIN AP101_MPM.dbo.WRK_CNTR W
        ON W.OID = O.WRK_CNTR_OID
    WHERE L.LNG_TXT IS NOT NULL
      AND P.PLNT_OID = 3
) T2
    ON T1.PROD_ORDR_NBR = T2.PROD_ORDR_NBR
   AND T2.LNG_TXT LIKE '%' + T1.DOC_NBR + '%';
 
