let
    Source =
        Sql.Database(
            "SCGReporting",
            "PowerBI",
            [
                Query = "
WITH LaborByConfirmation AS
(
    SELECT
        [CNFRM_NBR],
        CAST(SUM([LBR_SCNDS]) / 3600.00 AS DECIMAL(18,4)) AS [ACT_TM],
        SUM([QTY_CMPL]) AS [QTY_CMPL]
    FROM [AP101_MPM].[dbo].[LBR_HIST] WITH(NOLOCK)
    WHERE [PLNT_OID] IN (3,4)
      AND [DEL_FLG] = 0
      AND [LBR_TYPE_CD] <> 'I'
    GROUP BY [CNFRM_NBR]
),

Anchor AS
(
    SELECT
        LTRIM(RTRIM(G1.[PLNT_CD])) AS [PLANT],

        CASE
            WHEN E1.[NM] IS NULL THEN CONCAT(G1.[PLNT_CD], '_Unknown')
            WHEN C1.[WRK_CNTR_CD] IN ('MH775100', 'CM783100')
                THEN 'Mfg Sing3 Material Science Lab'
            ELSE E1.[NM]
        END AS [BU_NAME],

        C1.[WRK_CNTR_CD] AS [WRK_CNTR],
        SUBSTRING(
            A1.[CNFRM_NBR],
            PATINDEX('%[^0 ]%', A1.[CNFRM_NBR] + ' '),
            LEN(A1.[CNFRM_NBR])
        ) AS [CNFRM_NBR],
        SUBSTRING(
            B1.[PROD_ORDR_NBR],
            PATINDEX('%[^0 ]%', B1.[PROD_ORDR_NBR] + ' '),
            LEN(B1.[PROD_ORDR_NBR])
        ) AS [PROD_ORDR_NBR],
        SUBSTRING(
            A1.[OPR_NBR],
            PATINDEX('%[^0 ]%', A1.[OPR_NBR] + ' '),
            LEN(A1.[OPR_NBR])
        ) AS [OPR_NBR],
        SUBSTRING(
            F1.[MTRL_NBR],
            PATINDEX('%[^0 ]%', F1.[MTRL_NBR] + ' '),
            LEN(F1.[MTRL_NBR])
        ) AS [MTRL_NBR],
        F1.[MTRL_DSC] AS [MTRL_DESCRIPTION],
        COALESCE(I1.[MRP_CNTRLR_CD], 'Unknown') AS [MRP_CNTRLR],
        L1.[ACT_TM],
        L1.[QTY_CMPL] / A1.[UOM_CNVRSN_RATIO] AS [QTY_CMPL],
        A1.[ACT_STRT_DT],
        A1.[ACT_CMPL_DT],
        A1.[DSC] AS [OPRN_DESCRIPTION]

    FROM [AP101_MPM].[dbo].[PROD_ORDR_OPR] A1 WITH(NOLOCK)

    LEFT JOIN [AP101_MPM].[dbo].[PROD_ORDR] B1 WITH(NOLOCK)
        ON B1.[OID] = A1.[PROD_ORDR_OID]

    LEFT JOIN [AP101_MPM].[dbo].[WRK_CNTR] C1 WITH(NOLOCK)
        ON C1.[OID] = A1.[WRK_CNTR_OID]

    LEFT JOIN [AP101_MPM].[dbo].[COST_CNTR] D1 WITH(NOLOCK)
        ON D1.[OID] = C1.[COST_CNTR_OID]

    LEFT JOIN [AP101_MPM].[dbo].[BSNS_UNIT] E1 WITH(NOLOCK)
        ON E1.[OID] = D1.[BSNS_UNIT_OID]

    LEFT JOIN [AP101_MPM].[dbo].[MTRL] F1 WITH(NOLOCK)
        ON F1.[OID] = B1.[MTRL_OID]

    LEFT JOIN [AP101_MPM].[dbo].[PLNT] G1 WITH(NOLOCK)
        ON G1.[OID] = A1.[OPR_PLNT_OID]

    LEFT JOIN [AP101_MPM].[dbo].[MRP_CNTRLR] I1 WITH(NOLOCK)
        ON I1.[OID] = B1.[MRP_CNTRLR_OID]

    LEFT JOIN LaborByConfirmation L1
        ON L1.[CNFRM_NBR] = A1.[CNFRM_NBR]

    WHERE A1.[MPM_ORDR_OPR_STAT_CD] = 'C'
      AND A1.[OPR_PLNT_OID] IN (3,4)
      AND G1.[PLNT_CD] = '2088'
      AND A1.[ACT_CMPL_DT] >= '2024-01-01'
),

EmployeeRows AS
(
    SELECT DISTINCT
        SUBSTRING(
            L1.[CNFRM_NBR],
            PATINDEX('%[^0 ]%', L1.[CNFRM_NBR] + ' '),
            LEN(L1.[CNFRM_NBR])
        ) AS [CNFRM_NBR],
        NULLIF(
            LTRIM(RTRIM(CONVERT(VARCHAR(100), E1.[EMPL_NBR]))),
            ''
        ) AS [EMPL_NBR],
        E1.[DSPLY_NM] AS [EMPL_NAME]
    FROM [AP101_MPM].[dbo].[LBR_HIST] L1 WITH(NOLOCK)
    INNER JOIN [AP101_MPM].[dbo].[EMPL] E1 WITH(NOLOCK)
        ON E1.[OID] = L1.[EMPL_OID]
    WHERE L1.[PLNT_OID] = 3
      AND L1.[DEL_FLG] = 0
      AND L1.[LBR_TYPE_CD] <> 'I'
      AND L1.[PAY_DT] >= '2024-01-01'
),

SpecificationRows AS
(
    SELECT DISTINCT
        SUBSTRING(
            M1.[MTRL_NBR],
            PATINDEX('%[^0 ]%', M1.[MTRL_NBR] + ' '),
            LEN(M1.[MTRL_NBR])
        ) AS [MTRL_NBR],
        D1.[Name] AS [SPEC]
    FROM [DUN02_HESDATAMART01].[EnoviaData].[Documents] D1
    INNER JOIN [AP101_MPM].[dbo].[PROD_ORDR_BOM_DTL] DTL
        ON D1.[Name] = DTL.[DOC_NBR]
    INNER JOIN [AP101_MPM].[dbo].[PROD_ORDR_BOM] BOM
        ON DTL.[PROD_ORDR_BOM_OID] = BOM.[OID]
    INNER JOIN [AP101_MPM].[dbo].[PROD_ORDR] P1
        ON BOM.[PROD_ORDR_OID] = P1.[OID]
    INNER JOIN [AP101_MPM].[dbo].[MTRL] M1
        ON P1.[MTRL_OID] = M1.[OID]
    INNER JOIN [AP101_MPM].[dbo].[PLNT] PL1
        ON P1.[PLNT_OID] = PL1.[OID]
    WHERE D1.[latest] = 1
      AND D1.[current] = 'Production Release'
      AND PL1.[PLNT_CD] = '2088'
),

ExpandedRows AS
(
    SELECT
        A1.[PLANT],
        A1.[BU_NAME],
        A1.[WRK_CNTR],
        A1.[CNFRM_NBR],
        A1.[PROD_ORDR_NBR],
        A1.[OPR_NBR],
        A1.[MTRL_NBR],
        A1.[MTRL_DESCRIPTION],
        A1.[MRP_CNTRLR],
        A1.[ACT_TM],
        A1.[QTY_CMPL],
        A1.[ACT_STRT_DT],
        A1.[ACT_CMPL_DT],
        A1.[OPRN_DESCRIPTION],
        E1.[EMPL_NBR] AS [Employee Number],
        E1.[EMPL_NAME] AS [Employee Name],
        S1.[SPEC] AS [Specification]
    FROM Anchor A1
    LEFT JOIN EmployeeRows E1
        ON E1.[CNFRM_NBR] = A1.[CNFRM_NBR]
    LEFT JOIN SpecificationRows S1
        ON S1.[MTRL_NBR] = A1.[MTRL_NBR]
)

SELECT
    [PLANT],
    [BU_NAME],
    [WRK_CNTR],
    [CNFRM_NBR],
    [PROD_ORDR_NBR],
    [OPR_NBR],
    [MTRL_NBR],
    [MTRL_DESCRIPTION],
    [MRP_CNTRLR],
    [QTY_CMPL],
    [ACT_STRT_DT],
    [ACT_CMPL_DT],
    [OPRN_DESCRIPTION],
    [Employee Number],
    [Employee Name],
    [Specification],
    CAST(
        [ACT_TM]
        / NULLIF(
            CAST(
                COUNT(*) OVER (
                    PARTITION BY [CNFRM_NBR]
                )
                AS DECIMAL(19,4)
            ),
            0
        )
        AS DECIMAL(28,12)
    ) AS [ACT_TM_WEIGHTED]
FROM ExpandedRows
"
            ]
        ),

    #"Formatted Date Columns" =
        Table.TransformColumns(
            Source,
            {
                {
                    "ACT_STRT_DT",
                    each
                        if _ = null then
                            null
                        else
                            Date.ToText(
                                Date.From(_),
                                [Format = "M/dd/yyyy", Culture = "en-US"]
                            ),
                    type text
                },
                {
                    "ACT_CMPL_DT",
                    each
                        if _ = null then
                            null
                        else
                            Date.ToText(
                                Date.From(_),
                                [Format = "M/dd/yyyy", Culture = "en-US"]
                            ),
                    type text
                }
            }
        ),

    #"Added Specification Pillar" =
        Table.AddColumn(
            #"Formatted Date Columns",
            "Specification Pillar",
            each
                if [Specification] = null then
                    null
                else
                    Text.BeforeDelimiter([Specification], "-")
                    & "-"
                    &
                    Text.Select(
                        Text.BeforeDelimiter(
                            Text.AfterDelimiter([Specification], "-"),
                            "-"
                        ),
                        {"A".."Z"}
                    ),
            type text
        ),

    #"Removed Null Specifications" =
        Table.SelectRows(
            #"Added Specification Pillar",
            each [Specification] <> null
        ),

    #"Filtered ES-T Specification Pillar" =
        Table.SelectRows(
            #"Removed Null Specifications",
            each [Specification Pillar] = "ES-T"
        ),

    #"Reordered Columns" =
        Table.ReorderColumns(
            #"Filtered ES-T Specification Pillar",
            {
                "PLANT",
                "BU_NAME",
                "WRK_CNTR",
                "CNFRM_NBR",
                "PROD_ORDR_NBR",
                "OPR_NBR",
                "MTRL_NBR",
                "MTRL_DESCRIPTION",
                "MRP_CNTRLR",
                "QTY_CMPL",
                "ACT_STRT_DT",
                "ACT_CMPL_DT",
                "OPRN_DESCRIPTION",
                "Employee Number",
                "Employee Name",
                "Specification",
                "Specification Pillar",
                "ACT_TM_WEIGHTED"
            }
        )
in
    #"Reordered Columns"
