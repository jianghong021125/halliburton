let
    // Power BI query name: Testing Hours By PF.
    CharactersAfterPrefix = 13,
    SpecDelimiters = {
        ",", ";", ":", ".", "/", Character.FromNumber(92), "|",
        "(", ")", "[", "]", "{", "}", "<", ">",
        Character.FromNumber(34), "'", "!", "?", "=", "+", "&",
        "#(cr)", "#(lf)", "#(tab)"
    },

    ExtractSpecs = (value as nullable text) as list =>
        if value = null then {} else
        let
            Starts = List.Buffer(Text.PositionOf(value, "ES-", Occurrence.All)),
            Boundaries = Starts & {Text.Length(value)},
            Specs = List.Transform(
                List.Positions(Starts),
                (index) =>
                    let
                        Start = Starts{index},
                        Length = List.Min({3 + CharactersAfterPrefix, Boundaries{index + 1} - Start}),
                        Fragment = Text.Range(value, Start, Length),
                        Stop = Text.PositionOfAny(Fragment, SpecDelimiters),
                        Token = if Stop < 0 then Fragment else Text.Start(Fragment, Stop)
                    in
                        Text.Remove(Token, {" "})
            )
        in
            List.Select(Specs, each Text.Length(_) > 3),

    Source = #"Anchor Table Testing",

    #"Selected Anchor Columns" =
        Table.SelectColumns(
            Source,
            {
                "PLANT", "CMPL_YEAR_MO", "BU_NAME", "WRK_CNTR", "CNFRM_NBR",
                "PROD_ORDR_NBR", "OPR_NBR", "MTRL_NBR",
                "MTRL_DESCRIPTION", "MRP_CNTRLR", "ACT_TM",
                "QTY_CMPL", "ACT_STRT_DT", "ACT_CMPL_DT",
                "OPRN_DESCRIPTION", "P_LNG_TXT"
            }
        ),

    #"Formatted Dates" =
        Table.TransformColumns(
            #"Selected Anchor Columns",
            {
                {"ACT_STRT_DT", each Date.ToText(Date.From(_), [Format = "M/dd/yyyy", Culture = "en-US"]), type text},
                {"ACT_CMPL_DT", each Date.ToText(Date.From(_), [Format = "M/dd/yyyy", Culture = "en-US"]), type text}
            }
        ),

    // Keep every occurrence, including repeated specs. Empty lists produce no rows.
    #"Extracted ES Specs" =
        Table.AddColumn(#"Formatted Dates", "ES SPECS", each ExtractSpecs([P_LNG_TXT]), type list),

    #"Expanded ES Specs" =
        Table.ExpandListColumn(#"Extracted ES Specs", "ES SPECS"),

    #"Added Specification Pillar" =
        Table.AddColumn(
            #"Expanded ES Specs",
            "Specification Pillar",
            each
                let
                    Parts = Text.Split([ES SPECS], "-")
                in
                    Parts{0} & "-" & Text.Select(Parts{1}, {"A".."Z"}),
            type text
        )
in
    #"Added Specification Pillar"
