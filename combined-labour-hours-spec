let
    // Power BI query name: Testing Hours by PF.
    RequiredPillar = "ES-T",
    Source = #"Anchor Table Testing",

    #"Selected Anchor Columns" =
        Table.SelectColumns(
            Source,
            {
                "PLANT", "BU_NAME", "WRK_CNTR", "CNFRM_NBR",
                "PROD_ORDR_NBR", "OPR_NBR", "MTRL_NBR",
                "MTRL_DESCRIPTION", "MRP_CNTRLR", "ACT_TM",
                "QTY_CMPL", "ACT_STRT_DT", "ACT_CMPL_DT",
                "OPRN_DESCRIPTION"
            }
        ),

    // Prepare the small lookup before expanding the Anchor rows.
    // Use spec-to-mtrl_nbr for this dependency; both join keys are text.
    #"Selected Specification Columns" =
        Table.SelectColumns(
            #"Specification <-> Material Number ( AP SPECS )",
            {"MTRL_NBR", "SPEC"}
        ),

    #"Distinct Material Specifications" =
        Table.Distinct(#"Selected Specification Columns"),

    #"Renamed Specification" =
        Table.RenameColumns(
            #"Distinct Material Specifications",
            {{"SPEC", "Specification"}}
        ),

    #"Added Specification Pillar" =
        Table.AddColumn(
            #"Renamed Specification",
            "Specification Pillar",
            each
                let
                    Parts =
                        if [Specification] = null then
                            {}
                        else
                            Text.Split([Specification], "-")
                in
                    if List.Count(Parts) < 2 then
                        null
                    else
                        Parts{0} & "-" & Text.Select(Parts{1}, {"A".."Z"}),
            type nullable text
        ),

    #"Filtered Specification Pillar" =
        Table.SelectRows(
            #"Added Specification Pillar",
            each [Specification Pillar] = RequiredPillar
        ),

    // Inner join is equivalent to left join then retaining only ES-T rows.
    #"Merged Specifications" =
        Table.NestedJoin(
            #"Selected Anchor Columns",
            {"MTRL_NBR"},
            #"Filtered Specification Pillar",
            {"MTRL_NBR"},
            "Specifications",
            JoinKind.Inner
        ),

    #"Expanded Specifications" =
        Table.ExpandTableColumn(
            #"Merged Specifications",
            "Specifications",
            {"Specification", "Specification Pillar"},
            {"Specification", "Specification Pillar"}
        )
in
    #"Expanded Specifications"
